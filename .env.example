# Copy to .env.local and fill in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=/api

# --- Opportunity Discovery --------------------------------------------------
# Provider priority: explicit OPPORTUNITY_DISCOVERY_PROVIDER > Google Places
# (if keyed) > Foursquare (if keyed) > OpenStreetMap (free, no key, default).
# Everything below can stay blank — discovery already works via OpenStreetMap.

# google_places | foursquare | openstreetmap  (optional)
OPPORTUNITY_DISCOVERY_PROVIDER=

# Paid providers — optional:
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

# Free provider (OpenStreetMap) — optional tuning, no key needed:
OPPORTUNITY_OSM_RADIUS_METERS=8000
OPPORTUNITY_OSM_CACHE_TTL_MS=600000
OPPORTUNITY_OSM_USER_AGENT=

# --- AI Opportunity Intelligence --------------------------------------------
# Gemini is the active/default provider. Without a key, discovery, scoring and
# evidence still work; only the AI analysis + outreach drafts are unavailable.

# gemini | anthropic (optional — auto-selects Gemini once GEMINI_API_KEY is set)
AI_PROVIDER=

# https://aistudio.google.com/app/apikey — server-side only, never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional secondary provider — NOT required for Opportunity Discovery.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Website analysis fetch timeout per page in ms (2000–30000)
OPPORTUNITY_WEBSITE_TIMEOUT_MS=9000

# How long a successful AI analysis is cached per business+evidence, in ms
OPPORTUNITY_AI_CACHE_TTL_MS=604800000

# CRM persistence — optional. Without these, leads persist to ./.data/opportunity-leads.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram Social Media Intelligence -----------------------------------
# "Instagram API with Instagram Login" — server-side OAuth, tokens never sent to the browser.
# Meta app -> Instagram product -> API setup with Instagram login.
# Redirect URL: <APP_BASE_URL>/api/social/instagram/callback
# Permissions: instagram_business_basic, instagram_business_manage_insights
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
APP_BASE_URL=http://localhost:3000
INSTAGRAM_GRAPH_VERSION=
# Publishing needs instagram_business_content_publish + App Review. Off unless set to "true".
INSTAGRAM_ENABLE_PUBLISHING=
SOCIAL_CRON_SECRET=

# --- YouTube Channel Intelligence --------------------------------------------
# Google OAuth2, server-side. Google Cloud Console -> enable "YouTube Data API
# v3" -> OAuth 2.0 Client ID -> set the redirect URI below in that dashboard.
# Scope: https://www.googleapis.com/auth/youtube.readonly (read-only).
# Redirect URL: <APP_BASE_URL>/api/social/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# --- TikTok Login Kit / Display API ------------------------------------------
# Server-side OAuth2 + PKCE. https://developers.tiktok.com/apps -> add "Login
# Kit" -> set the redirect URI below in that dashboard exactly.
# Scopes: user.info.basic, video.list (read-only — never posts to TikTok).
# Redirect URL: <APP_BASE_URL>/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- AI Evaluation Lab -------------------------------------------------------
# Model benchmarking & AI quality testing. Six independent model slots — every
# one below is optional; MarketMind runs fully with none of them set (and the
# Lab still works fully with just GEMINI_API_KEY already set above). No model
# is ever called unless you explicitly select it and confirm a benchmark run.

# Gemini (Google) — reuses GEMINI_API_KEY above. Optional override of the
# model used for benchmarking specifically (falls back to GEMINI_MODEL, then
# a known-good default).
GEMINI_BENCHMARK_MODEL=

# GPT-OSS 120B + Qwen (Groq) — one key, two model slots.
GROQ_API_KEY=
GROQ_GPT_OSS_MODEL=
GROQ_QWEN_MODEL=

# Nemotron (OpenRouter) — must be a specific pinned model id, never a router
# alias like "openrouter/free" (reproducibility requirement).
OPENROUTER_API_KEY=
OPENROUTER_NEMOTRON_MODEL=

# GPT (OpenAI) — optional, paid only. MarketMind functions completely without it.
OPENAI_API_KEY=
OPENAI_BENCHMARK_MODEL=

# Claude (Anthropic) — optional secondary benchmark model. Reuses
# ANTHROPIC_API_KEY above if set; override the benchmark model here.
ANTHROPIC_BENCHMARK_MODEL=

# RunPod Serverless — AI Studio's Birthday Visual Generator (SDXL +
# SMB-Birthday-v2 LoRA, see inference-worker/). Server-side only, never
# exposed to the browser. Until both are set, POST /api/ai-studio/generate
# returns { configured: false } instead of attempting a call.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
